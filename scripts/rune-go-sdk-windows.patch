+
+// sessionFlags reads Setsid and Setctty when those fields exist.
+// Windows syscall.SysProcAttr does not have them; direct references do not compile.
+func sessionFlags(attr *syscall.SysProcAttr) (setsid, setctty bool) {
+	if attr == nil {
+		return false, false
+	}
+	v := reflect.ValueOf(attr).Elem()
+	if f := v.FieldByName("Setsid"); f.IsValid() && f.Kind() == reflect.Bool {
+		setsid = f.Bool()
+	}
+	if f := v.FieldByName("Setctty"); f.IsValid() && f.Kind() == reflect.Bool {
+		setctty = f.Bool()
+	}
+	return setsid, setctty
+}
